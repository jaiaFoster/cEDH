DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commander_doubles
DATABASE_SCHEMA=league_local
APP_ENV=local
NODE_ENV=development
PORT=3000
ADMIN_PASSWORD=replace-for-local-development
SESSION_SECRET=replace-with-at-least-32-random-bytes
CHALLONGE_API_KEY=
ALLOW_MOCK=true
# Production: ALLOW_MOCK=false, NODE_ENV=production, DATABASE_SCHEMA=league_production
# Optional: ADMIN_PASSWORD_HASH=<scrypt salt:hash, replaces ADMIN_PASSWORD>
# PUBLIC_URL=https://your-domain (optional strict canonical origin)
