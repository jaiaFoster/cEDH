{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedh-research.local/schemas/topdeck_tournament.schema.json",
  "title": "Normalized TopDeck tournament",
  "type": "object",
  "required": ["schema_version", "source", "attribution", "pulled_at", "content_hash", "tid", "name", "field_size", "decklist_coverage", "entries", "pods"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"const": "topdeck.gg"},
    "attribution": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {"const": "TopDeck.gg"},
        "url": {"const": "https://topdeck.gg"}
      },
      "additionalProperties": false
    },
    "pulled_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tid": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "game": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]},
    "start_date_unix": {"type": ["integer", "number", "null"]},
    "start_date_utc": {"type": ["string", "null"], "format": "date-time"},
    "swiss_rounds": {"type": ["integer", "number", "null"]},
    "top_cut_size": {"type": "integer", "minimum": 0},
    "event_data": {"type": "object"},
    "field_size": {"type": "integer", "minimum": 0},
    "decklist_coverage": {
      "type": "object",
      "required": ["submitted", "structured", "total"],
      "properties": {
        "submitted": {"type": "integer", "minimum": 0},
        "structured": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "entries": {"type": "array", "items": {"type": "object"}},
    "pods": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
